NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database & Security
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/premium_store?retryWrites=true&w=majority
JWT_SECRET=production_super_secure_jwt_secret_key_minimum_64_char_long
AES_SECRET_KEY=production_32_byte_aes_encryption_secret_key!

# CORS & Domain
CORS_ORIGIN=https://your-telegram-storefront.vercel.app

# Telegram & Firebase Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com
