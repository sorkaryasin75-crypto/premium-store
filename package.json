{
  "name": "premium-store-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Premium Telegram Digital Store",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "admin"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=shared",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "build:all": "npm run build:shared && npm run build --workspace=backend && npm run build --workspace=frontend && npm run build --workspace=admin"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
