# SERVER CONFIGURATION
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# DATABASE CONFIGURATION
MONGODB_URI=mongodb://localhost:27017/telegram_digital_store?replicaSet=rs0

# TELEGRAM BOT & WEBAPP SECURITY
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE
TELEGRAM_WEBAPP_URL=https://t.me/YourBotName/app

# JWT SECURITY KEYS
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_for_production
ADMIN_SECRET=super_secret_admin_jwt_key_min_32_characters_long

# FIREBASE CONFIGURATION
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
